// Installed by the zapret-gtk package to /usr/share/polkit-1/rules.d/.
//
// Lets users in an active local session start, stop and restart ONLY
// zapret.service without a password, so the tray toggle works silently.
// (install.sh limits this to the installing user; a package can't know who
// that is, so it allows anyone sitting at the machine instead.)
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "zapret.service" &&
        subject.active && subject.local) {
        var verb = action.lookup("verb");
        if (verb == "start" || verb == "stop" || verb == "restart") {
            return polkit.Result.YES;
        }
    }
});
