#include <windows.h>
#include "resource.h"

IDI_APP ICON "zapret-on.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "zapret_service.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     APP_VERSION_NUM
PRODUCTVERSION  APP_VERSION_NUM
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription",  "Zapret service (runs winws)"
            VALUE "ProductName",      "Zapret tray"
            VALUE "FileVersion",      APP_VERSION_STR
            VALUE "ProductVersion",   APP_VERSION_STR
            VALUE "InternalName",     "zapret-service"
            VALUE "OriginalFilename", "zapret-service.exe"
            VALUE "LegalCopyright",   "MIT License"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
